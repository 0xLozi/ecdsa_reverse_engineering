void print_result(KIRK_CMD12_BUFFER* keypair) {
    printf("PRIVATE KEY:");
    for (int i = 0; i < 20; i++) {
        printf("%02X", keypair->private_key[i]);
    }
    printf("\n");

    printf("Public Key (X)\n");
    for (int i = 0; i < 20; i++) {
        printf("%02X", keypair->public_key.x[i]);
    }
    printf("\n");

    printf("Public Key (Y)\n");
    for (int i = 0; i < 20; i++) {
        printf("%02X", keypair->public_key.y[i]);
    }
    printf("\n");
}



